# ── Data directories (all runtime-generated, never commit) ───────────────────
data/documents/          # uploaded user files
data/index/              # BM25 RAG index
data/analytics/          # uploaded analytics datasets
data/auth/               # user accounts DB
data/mcp_client/         # MCP server configs (may contain credentials)
data/memory/             # persistent memory store
data/news/               # news articles cache
data/notes/              # proactive notes
data/conversations.db    # (also matched by *.db above)
static/analytics/        # generated Plotly chart files
data/
